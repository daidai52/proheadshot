# Environment
DATABASE_URL="postgresql://user:password@host:port/dbname"
DIRECT_URL="postgresql://user:password@host:port/dbname"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_here"

# SiliconFlow API (for AI headshot generation - Chinese AI platform, supports Alipay)
SILICONFLOW_API_KEY="sk-your_siliconflow_key_here"

# PayPal (for payments)
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"
PAYPAL_EMAIL="your_paypal_email@example.com"
# Set to sandbox for testing, change to live for production
PAYPAL_API_URL="https://api-m.sandbox.paypal.com"
